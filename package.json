{
  "name": "gdocs-artifacts",
  "version": "0.0.0",
  "description": "MCP server that lets agents read and edit Google Docs as Markdown, with comments and suggestions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tillahoffmann/gdocs-artifacts.git"
  },
  "homepage": "https://github.com/tillahoffmann/gdocs-artifacts",
  "bugs": {
    "url": "https://github.com/tillahoffmann/gdocs-artifacts/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run --no-file-parallelism",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "googleapis": "^189.0.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "gdocs-artifacts": "dist/cli.js"
  }
}
