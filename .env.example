# The server's OAuth client (a Desktop app client), instead of running `gdocs-artifacts setup`.
GDOCS_ARTIFACTS_CLIENT_ID=
GDOCS_ARTIFACTS_CLIENT_SECRET=

# OAuth clients for the live tests, one per test account. Refresh tokens are added by the tests after the
# first browser sign-in.
GDOCS_GMAIL_CLIENT_ID=
GDOCS_GMAIL_CLIENT_SECRET=
GDOCS_WORKSPACE_CLIENT_ID=
GDOCS_WORKSPACE_CLIENT_SECRET=
